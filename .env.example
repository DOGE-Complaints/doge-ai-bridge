# =============================================================================
# doge-ai-bridge — environment template for node installers
# =============================================================================
# Copy to `.env` (gitignored) and fill real values. NEVER commit secrets.
#
# Source of truth for names/defaults: src/aibridge/config.py (Settings)
# Web-only start (local + Railway): docs/runbooks/aibridge-web-service-local-railway.md
# Full pilot (n8n/Telegram): docs/runbooks/AIBRIDGE-RAILWAY-N8N-TELEGRAM-PILOT-RUNBOOK.md
# Readyz rules: src/aibridge/readiness.py (no OpenAI generation / no gateway write)
#
# Quick rules:
# - Railway Postgres exposes PGHOST/PGUSER/… — aibridge needs ONLY DATABASE_URL.
# - Channel Bearer ≠ Gateway Bearer ≠ OpenAI key ≠ Telegram bot token (all distinct).
# - Wave-1 pilot: AIBRIDGE_DRY_RUN=true until schema validation is proven.
# - Content bundle paths must exist inside the running image/process cwd — do not invent paths.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) PROCESS / LISTEN
# Used by: python -m aibridge / uvicorn (--port). n8n private URL must match this port.
# -----------------------------------------------------------------------------
PORT=8080
AIBRIDGE_LOG_LEVEL=INFO
# Stable id for this node/deployment (pinned into sessions / tokens / confirm).
AIBRIDGE_DEPLOYMENT_ID=local


# -----------------------------------------------------------------------------
# 2) DATABASE (PostgreSQL SSOT)
# Used by: migrate.py, sessions/history/tokens/confirm/dedupe stores, /readyz migration check.
# Production/pilot: postgresql://… and ALLOW_MEMORY=false.
# Local throwaway only: sqlite or empty + ALLOW_MEMORY=true (not for residents).
# Apply migrations once: PYTHONPATH=src python -c "from aibridge.migrate import apply_migrations; import os; apply_migrations(os.environ['DATABASE_URL'])"
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/aibridge
AIBRIDGE_ALLOW_MEMORY_STORES=false


# -----------------------------------------------------------------------------
# 3) CHANNEL AUTH (n8n / Telegram router → aibridge)
# Used by: Bearer check on POST /v1/channel/turns and /v1/channel/actions; /readyz.
# Create: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Put the SAME value in n8n HTTP Request Authorization. Do NOT reuse gateway Bearer.
# PREVIOUS: optional rotation window — both tokens accepted until cutover complete.
# -----------------------------------------------------------------------------
AIBRIDGE_CHANNEL_BEARER_TOKEN=
AIBRIDGE_CHANNEL_PREVIOUS_BEARER_TOKEN=


# -----------------------------------------------------------------------------
# 4) OPENAI RESPONSES (aibridge → OpenAI only; never put in n8n)
# Used by: Responses client; /readyz checks key+model presence and store:false.
# OPENAI_STORE_RESPONSES=true is REJECTED at settings load (aibridge forces store:false).
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_STORE_RESPONSES=false


# -----------------------------------------------------------------------------
# 5) INTAKE SERVICE + SPA REDIRECT (aibridge → node intake API + resident SPA)
# Used by: stash executor HTTPS; /readyz HTTPS origin + redirect base checks.
#
# DOGESTONIA_INTAKE_BASE_URL — MANDATORY public HTTPS origin of the node intake
#   service (no path, no trailing slash required). Complaints node = gateway.
#   Other node types may point at a different intake service. No fallback aliases.
#   Empty → /readyz intake_base_url_missing; non-HTTPS → intake_base_url_not_https.
# DOGESTONIA_API_BEARER_TOKEN — service Bearer for that intake origin; MUST differ from channel Bearer.
# DOGESTONIA_DRAFT_REDIRECT_BASE_URL — public SPA base used to build continuation_url after stash.
# -----------------------------------------------------------------------------
DOGESTONIA_INTAKE_BASE_URL=https://gateway.example.invalid
DOGESTONIA_API_BEARER_TOKEN=
DOGESTONIA_DRAFT_REDIRECT_BASE_URL=https://spa.example.invalid


# -----------------------------------------------------------------------------
# 6) GATEWAY OPERATION BINDING (server-owned fields on stash body)
# Used by: request assembly / confirm / gateway payload. Model cannot override these.
# OPERATION_ID must match the Story Intake operation aibridge is allowed to call.
# ORIGIN_SOURCE is the pilot provenance tag (Telegram + Responses path).
# -----------------------------------------------------------------------------
DOGESTONIA_OPERATION_ID=postStoryDraftStash
DOGESTONIA_ORIGIN_SOURCE=openai_responses_telegram


# -----------------------------------------------------------------------------
# 7) WAVE / SAFETY GATES
# Used by: /readyz dry-run gate (REQ-03 wave boundary).
# Keep DRY_RUN=true for wave-1 (zero real POST /story-drafts).
# Set SCHEMA_VALIDATION_COMPLETE=true only after full schema validation is proven (R3-P1-03);
# then DRY_RUN=false may pass readiness. Until then DRY_RUN=false → not_ready: dry_run_required.
# -----------------------------------------------------------------------------
AIBRIDGE_DRY_RUN=true
AIBRIDGE_SCHEMA_VALIDATION_COMPLETE=false


# -----------------------------------------------------------------------------
# 8) CONTENT BUNDLE PIN — REQ-05 Phase A (flat dump + OAS in image)
# Used by: content.py / deployment.py; registered in Postgres content_bundle;
#   assembled instructions sent EACH turn (OpenAI store:false — LLM does NOT keep them).
#
# content_configured() is TRUE only when ALL of these are non-empty:
#   CONTENT_SOURCE_COMMIT, INSTRUCTIONS_DIR, INSTRUCTIONS_MANIFEST, OPENAPI_PATH, PAYLOAD_SCHEMA_PATH
#
# OPENAPI_PATH = Story Intake wire OAS (story-intake-actions.openapi.yaml) — NOT aibridge-channel-v1.
# Channel OAS is copied into the image with docs/openapi/ but must NOT appear in instruction files[].
# TOOL_SCHEMA_PATH = optional recorded strict-tool JSON; empty is OK until wiring requires it.
# SCHEMA_ID + SCHEMA_VERSION = active pack identity (Phase A: uus_veerenni_civic / v3).
#
# Local (cwd = doge-ai-bridge):
#   DOGESTONIA_INSTRUCTIONS_DIR=src/instructions
#   DOGESTONIA_INSTRUCTIONS_MANIFEST=src/instructions/instructions.manifest.json
#   DOGESTONIA_OPENAPI_PATH=docs/openapi/story-intake-actions.openapi.yaml
#   DOGESTONIA_PAYLOAD_SCHEMA_PATH=src/instructions/schema-packs.uus_veerenni_civic.v3.payload.schema.json
# Image (WORKDIR /app — Dockerfile COPY src + migrations + docs/openapi):
#   DOGESTONIA_INSTRUCTIONS_DIR=/app/src/instructions
#   DOGESTONIA_INSTRUCTIONS_MANIFEST=/app/src/instructions/instructions.manifest.json
#   DOGESTONIA_OPENAPI_PATH=/app/docs/openapi/story-intake-actions.openapi.yaml
#   DOGESTONIA_PAYLOAD_SCHEMA_PATH=/app/src/instructions/schema-packs.uus_veerenni_civic.v3.payload.schema.json
# No new aliases — names below match config.py Settings only.
# -----------------------------------------------------------------------------
DOGESTONIA_INSTRUCTIONS_DIR=src/instructions
DOGESTONIA_INSTRUCTIONS_MANIFEST=src/instructions/instructions.manifest.json
DOGESTONIA_CONTENT_SOURCE_COMMIT=
DOGESTONIA_OPENAPI_PATH=docs/openapi/story-intake-actions.openapi.yaml
DOGESTONIA_PAYLOAD_SCHEMA_PATH=src/instructions/schema-packs.uus_veerenni_civic.v3.payload.schema.json
DOGESTONIA_TOOL_SCHEMA_PATH=
DOGESTONIA_SCHEMA_ID=uus_veerenni_civic
DOGESTONIA_SCHEMA_VERSION=v3


# -----------------------------------------------------------------------------
# 9) SESSION / TOKEN / BUNDLE RETENTION
# Used by: session TTL (privacy pilot default 7d), action-token expiry, bundle GC grace.
# TTL slides only on legitimate session activity (see privacy-pilot + story 16).
# -----------------------------------------------------------------------------
AIBRIDGE_SESSION_TTL_SECONDS=604800
AIBRIDGE_ACTION_TOKEN_TTL_SECONDS=900
AIBRIDGE_BUNDLE_GC_GRACE_SECONDS=86400


# -----------------------------------------------------------------------------
# 10) OPS PRIVACY DELETE (operator only — NOT channel Bearer)
# Used by: python -m aibridge.ops_session_delete (fail-closed if empty).
# Separate secret from channel/gateway. No channel OpenAPI delete path.
# -----------------------------------------------------------------------------
AIBRIDGE_OPS_BEARER_TOKEN=


# -----------------------------------------------------------------------------
# 11) HTTP SIZE / TIMEOUT LIMITS
# Used by: ASGI request body cap; gateway response size; outbound HTTP timeouts.
# CONNECT/TOTAL = general HTTP client; GATEWAY = stash call; OPENAI = Responses call.
# -----------------------------------------------------------------------------
AIBRIDGE_MAX_REQUEST_BYTES=65536
AIBRIDGE_MAX_RESPONSE_BYTES=1048576
AIBRIDGE_HTTP_CONNECT_TIMEOUT_MS=5000
AIBRIDGE_HTTP_TOTAL_TIMEOUT_MS=30000
AIBRIDGE_GATEWAY_TIMEOUT_SECONDS=30
AIBRIDGE_OPENAI_TIMEOUT_MS=60000


# -----------------------------------------------------------------------------
# 12) LLM BUDGETS + RATE LIMITS
# Used by: budgets.py / rate limiter on /turns (and related paths). Breach → resident-safe fail, no gateway side effect.
# Numbers below are finite pilot defaults from config.py — measure and tighten per node if needed.
# PRINCIPAL = per Telegram user/chat; GLOBAL = process-wide.
# -----------------------------------------------------------------------------
AIBRIDGE_MAX_INPUT_TOKENS=100000
AIBRIDGE_MAX_OUTPUT_TOKENS=16384
AIBRIDGE_MAX_RESPONSES_CALLS_PER_TURN=8
AIBRIDGE_MAX_TOOL_CALLS_PER_TURN=16
AIBRIDGE_MAX_SESSION_TURNS=100
AIBRIDGE_PRINCIPAL_RATE_LIMIT=60
AIBRIDGE_GLOBAL_RATE_LIMIT=600
