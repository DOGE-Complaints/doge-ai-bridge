# Local development only — never commit real secrets.
# Copy to .env and fill values (gitignored).
# Names from REQ-01 §17 / REQ-03 §5.6 — story 14 finite pilot defaults shown.
# DOGESTONIA_GATEWAY_ORIGIN is a temporary compatibility alias for DOGESTONIA_API_BASE_URL.
# If both are set to different values, /readyz fails (gateway_base_url_conflict).

PORT=8080
DATABASE_URL=sqlite:///./.aibridge-local.db
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_STORE_RESPONSES=false
AIBRIDGE_LOG_LEVEL=INFO

DOGESTONIA_INSTRUCTIONS_DIR=
DOGESTONIA_INSTRUCTIONS_MANIFEST=
DOGESTONIA_CONTENT_SOURCE_COMMIT=
DOGESTONIA_OPENAPI_PATH=
DOGESTONIA_PAYLOAD_SCHEMA_PATH=
DOGESTONIA_TOOL_SCHEMA_PATH=
DOGESTONIA_OPERATION_ID=postStoryDraftStash
DOGESTONIA_SCHEMA_ID=
DOGESTONIA_SCHEMA_VERSION=
DOGESTONIA_ORIGIN_SOURCE=openai_responses_telegram

# Canonical gateway HTTPS origin (REQ-03 §5.6)
DOGESTONIA_API_BASE_URL=https://gateway.example.invalid
# Temporary alias — prefer DOGESTONIA_API_BASE_URL; leave empty when canonical is set
DOGESTONIA_GATEWAY_ORIGIN=
DOGESTONIA_API_BEARER_TOKEN=
DOGESTONIA_DRAFT_REDIRECT_BASE_URL=https://spa.example.invalid

AIBRIDGE_CHANNEL_BEARER_TOKEN=
AIBRIDGE_CHANNEL_PREVIOUS_BEARER_TOKEN=
AIBRIDGE_MAX_REQUEST_BYTES=65536
# R3-P1-06 finite defaults (override as needed)
AIBRIDGE_MAX_RESPONSE_BYTES=1048576
AIBRIDGE_SESSION_TTL_SECONDS=604800
AIBRIDGE_ACTION_TOKEN_TTL_SECONDS=900
# Ops-only session delete (privacy). Not channel Bearer. Empty = delete fail-closed.
# HTTP channel delete path remains Unknown — do not invent OpenAPI fields.
AIBRIDGE_OPS_BEARER_TOKEN=
AIBRIDGE_HTTP_CONNECT_TIMEOUT_MS=5000
AIBRIDGE_HTTP_TOTAL_TIMEOUT_MS=30000
AIBRIDGE_GATEWAY_TIMEOUT_SECONDS=30
AIBRIDGE_DEPLOYMENT_ID=local
AIBRIDGE_BUNDLE_GC_GRACE_SECONDS=86400
# After R3-P1-03 proven: set AIBRIDGE_SCHEMA_VALIDATION_COMPLETE=true to allow dry_run=false
AIBRIDGE_DRY_RUN=true
AIBRIDGE_SCHEMA_VALIDATION_COMPLETE=false

# Story 09 — production: DATABASE_URL=postgresql://… and AIBRIDGE_ALLOW_MEMORY_STORES=false
# Schema SSOT: apply SQL under migrations/ before boot (not CREATE TABLE IF NOT EXISTS).
AIBRIDGE_ALLOW_MEMORY_STORES=true

# R3-P1-02 — finite pilot LLM / rate defaults
AIBRIDGE_MAX_INPUT_TOKENS=100000
AIBRIDGE_MAX_OUTPUT_TOKENS=16384
AIBRIDGE_MAX_RESPONSES_CALLS_PER_TURN=8
AIBRIDGE_MAX_TOOL_CALLS_PER_TURN=16
AIBRIDGE_OPENAI_TIMEOUT_MS=60000
AIBRIDGE_MAX_SESSION_TURNS=100
AIBRIDGE_PRINCIPAL_RATE_LIMIT=60
AIBRIDGE_GLOBAL_RATE_LIMIT=600
