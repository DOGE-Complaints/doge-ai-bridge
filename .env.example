# Local development only — never commit real secrets.
# Copy to .env and fill values (gitignored).

PORT=8080
AIBRIDGE_CHANNEL_BEARER_TOKEN=
AIBRIDGE_CHANNEL_PREVIOUS_BEARER_TOKEN=
DOGESTONIA_API_BEARER_TOKEN=
AIBRIDGE_MAX_REQUEST_BYTES=65536

# Story 02 — local content bundle (paths Unknown until CI pins absolutes)
# Production: DATABASE_URL=postgresql://… (psycopg). Offline: sqlite:// or memory.
DATABASE_URL=sqlite:///./.aibridge-local.db
DOGESTONIA_INSTRUCTIONS_DIR=
DOGESTONIA_INSTRUCTIONS_MANIFEST=
DOGESTONIA_CONTENT_SOURCE_COMMIT=
DOGESTONIA_OPENAPI_PATH=
DOGESTONIA_PAYLOAD_SCHEMA_PATH=
DOGESTONIA_TOOL_SCHEMA_PATH=
AIBRIDGE_DEPLOYMENT_ID=local
AIBRIDGE_BUNDLE_GC_GRACE_SECONDS=86400
