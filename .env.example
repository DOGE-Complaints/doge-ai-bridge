# Local development only — never commit real secrets.
# Copy to .env and fill values (gitignored).
# Names from REQ-01 §17 + arch budget knobs — values empty / commented.

PORT=8080
DATABASE_URL=sqlite:///./.aibridge-local.db
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_STORE_RESPONSES=false

DOGESTONIA_INSTRUCTIONS_DIR=
DOGESTONIA_INSTRUCTIONS_MANIFEST=
DOGESTONIA_CONTENT_SOURCE_COMMIT=
DOGESTONIA_OPENAPI_PATH=
DOGESTONIA_PAYLOAD_SCHEMA_PATH=
DOGESTONIA_TOOL_SCHEMA_PATH=
DOGESTONIA_OPERATION_ID=postStoryDraftStash
DOGESTONIA_SCHEMA_ID=
DOGESTONIA_SCHEMA_VERSION=
DOGESTONIA_ORIGIN_SOURCE=openai_responses_telegram

# Gateway origin (REQ §17 also names DOGESTONIA_API_BASE_URL — alias via GATEWAY_ORIGIN in settings)
DOGESTONIA_GATEWAY_ORIGIN=https://gateway.example.invalid
DOGESTONIA_API_BASE_URL=
DOGESTONIA_API_BEARER_TOKEN=
DOGESTONIA_DRAFT_REDIRECT_BASE_URL=

AIBRIDGE_CHANNEL_BEARER_TOKEN=
AIBRIDGE_CHANNEL_PREVIOUS_BEARER_TOKEN=
AIBRIDGE_MAX_REQUEST_BYTES=65536
AIBRIDGE_MAX_RESPONSE_BYTES=
AIBRIDGE_SESSION_TTL_SECONDS=
AIBRIDGE_ACTION_TOKEN_TTL_SECONDS=
AIBRIDGE_HTTP_CONNECT_TIMEOUT_MS=
AIBRIDGE_HTTP_TOTAL_TIMEOUT_MS=
AIBRIDGE_GATEWAY_TIMEOUT_SECONDS=
AIBRIDGE_DEPLOYMENT_ID=local
AIBRIDGE_BUNDLE_GC_GRACE_SECONDS=86400
AIBRIDGE_DRY_RUN=false

# LLM budgets — numeric defaults Unknown until measured (leave unset)
AIBRIDGE_MAX_INPUT_TOKENS=
AIBRIDGE_MAX_OUTPUT_TOKENS=
AIBRIDGE_MAX_RESPONSES_CALLS_PER_TURN=
AIBRIDGE_MAX_TOOL_CALLS_PER_TURN=
AIBRIDGE_OPENAI_TIMEOUT_MS=
AIBRIDGE_MAX_SESSION_TURNS=
AIBRIDGE_PRINCIPAL_RATE_LIMIT=
AIBRIDGE_GLOBAL_RATE_LIMIT=
